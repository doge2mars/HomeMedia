# Copy to .env and edit:  cp .env.example .env
# (.env is git-ignored — never commit it.)

# Cookie signing key. Empty = built-in insecure default. Generate one with: openssl rand -hex 32
HOME_MEDIA_SECRET=
# Initial admin password (only used the first time the database is created). Empty = admin123.
HOME_MEDIA_ADMIN_PASS=

# Run the container as this user/group so ./data is owned by you, not root.
# Find yours with `id -u` and `id -g` (first account on fnOS/Debian is usually 1000).
PUID=1000
PGID=1000

# Port for both host and container. The TV client / browser use http://<host>:<this port>
HOME_MEDIA_PORT=8090

# Where the data lives. Create this directory yourself before the first start.
# HOME_MEDIA_DATA_DIR=./data
# HOME_MEDIA_DATA_DIR=/vol1/1000/docker/home-media/data

# Optional: poster proxies used only when a direct fetch fails (comma separated).
# Can also be set later in the app's settings page.
# HOME_MEDIA_IMAGE_PROXIES=http://192.168.1.1:7890
